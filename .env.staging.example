# ==============================================================================
# ABLEBIZ SUITE — STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# File: .env.staging.example
# ==============================================================================
# STRICT SAFETY NOTICE:
# 1. DO NOT populate this file with PRODUCTION Supabase credentials or URLs.
# 2. To configure your staging environment, copy this file to:
#      .env.staging.local
#    which is strictly ignored by Git.
# 3. The automated pre-flight safety guard will ABORT immediately if the
#    configured project ref matches the production project (ksjphkqxudtkduuhnyvn).
# ==============================================================================

# Distinct Staging Supabase Project Reference (e.g., "abcdefghijklmnopqrst")
# MUST be completely distinct from production.
STAGING_SUPABASE_PROJECT_REF=your-isolated-staging-project-ref

# Staging Supabase API URL
STAGING_SUPABASE_URL=https://your-isolated-staging-project-ref.supabase.co

# Staging Supabase Anon Key (for public API testing)
STAGING_SUPABASE_ANON_KEY=your-staging-anon-key

# Staging Supabase Service-Role Key (REQUIRED ONLY FOR MIGRATION/ADMIN VALIDATION)
# NEVER commit or share this key.
STAGING_SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# Direct PostgreSQL Connection Details (for psql / migration validation scripts)
# Available in Supabase Dashboard -> Project Settings -> Database
STAGING_DB_HOST=db.your-isolated-staging-project-ref.supabase.co
STAGING_DB_PORT=5432
STAGING_DB_NAME=postgres
STAGING_DB_USER=postgres
STAGING_DB_PASSWORD=your-staging-db-password

# Explicit Staging Confirmation Flag (Must be set to "true")
STAGING_ENVIRONMENT_CONFIRMED=true
